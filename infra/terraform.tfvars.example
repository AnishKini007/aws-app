# Copy this file to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars — it is in .gitignore.

aws_region  = "ap-south-1"
project     = "mlops"
environment = "dev"

availability_zones   = ["ap-south-1a", "ap-south-1b"]
ssh_allowed_cidrs    = ["<YOUR_IP>/32"]

# db_password is set via environment variable:
#   export TF_VAR_db_password="<strong-password>"
# Do NOT put it here.

key_pair_name        = "<your-ec2-keypair-name>"   # optional, for SSH
mlflow_instance_type = "t3.small"
db_instance_class    = "db.t3.micro"
ecs_task_cpu         = 512
ecs_task_memory      = 1024
ecs_desired_count    = 1
